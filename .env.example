POSTGRES_DB=dungeoncore
POSTGRES_USER=dungeoncore
POSTGRES_PASSWORD=dungeoncore
POSTGRES_PORT=5432
POSTGRES_DSN=postgresql://dungeoncore:dungeoncore@postgres:5432/dungeoncore

REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

RABBITMQ_DEFAULT_USER=dungeoncore
RABBITMQ_DEFAULT_PASS=dungeoncore
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://dungeoncore:dungeoncore@rabbitmq:5672/

WEB_PORT=3000
API_PORT=8000
ORCHESTRATOR_PORT=8001
AGENT_RUNTIME_PORT=8002
GAME_ENGINE_PORT=8003
COMMUNICATION_SERVICE_PORT=8004
WEBSOCKET_BASE_URL=ws://localhost:8000/ws

MODEL_PROVIDER=lmstudio
LMSTUDIO_BASE_URL=http://host.docker.internal:1234
AZURE_AI_FOUNDRY_ENDPOINT=https://example-resource.services.ai.azure.com
AZURE_AI_FOUNDRY_API_KEY=replace-me

# Model Policy Defaults
DEFAULT_MODEL_NAME=local-model
DEFAULT_TEMPERATURE=0.4
DEFAULT_MAX_TOKENS=2048
DEFAULT_TIMEOUT_SECONDS=120.0

# DM Agent Policy (stronger narrative model with higher creativity)
DM_MODEL_NAME=
DM_TEMPERATURE=0.7
DM_MAX_TOKENS=4096

# Player Agent Policy (faster/cheaper model)
PLAYER_MODEL_NAME=
PLAYER_TEMPERATURE=0.4
PLAYER_MAX_TOKENS=2048

# Narrator Agent Policy (utility model)
NARRATOR_MODEL_NAME=
NARRATOR_TEMPERATURE=0.5
NARRATOR_MAX_TOKENS=1024
